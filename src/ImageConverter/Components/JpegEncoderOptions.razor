@using ImageConverter.Models.Encoding
@using ImageConverter.Models.Formats
@using SixLabors.ImageSharp.Formats.Jpeg
@inherits EncoderOptionsBase

<MudText Typo="Typo.body2" Class="mb-2">JPEG 质量：@_quality</MudText>
<MudSlider T="int" @bind-Value="_quality" @bind-Value:after="NotifySettingsChanged"
           Min="1" Max="100" Step="1" Color="MudBlazor.Color.Primary" Class="mb-4" />

<MudExpansionPanels Elevation="0" Dense="true" Class="mb-2 border-solid border rounded mud-border-primary">
    <MudExpansionPanel>
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="MudBlazor.Size.Small" Class="mr-2" />
                <MudText Typo="Typo.body2">高级选项</MudText>
            </div>
        </TitleContent>
        <ChildContent>
        <MudSelect T="JpegColorType?" @bind-Value="_colorType" @bind-Value:after="NotifySettingsChanged"
                   Label="色彩编码" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="JpegColorType?" Value="@((JpegColorType?)null)">自动</MudSelectItem>
            <MudSelectItem T="JpegColorType?" Value="JpegColorType.YCbCrRatio444">YCbCr 4:4:4（高质量）</MudSelectItem>
            <MudSelectItem T="JpegColorType?" Value="JpegColorType.YCbCrRatio420">YCbCr 4:2:0（更小）</MudSelectItem>
            <MudSelectItem T="JpegColorType?" Value="JpegColorType.Luminance">灰度</MudSelectItem>
            <MudSelectItem T="JpegColorType?" Value="JpegColorType.Rgb">RGB</MudSelectItem>
        </MudSelect>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private int _quality = 90;
    private JpegColorType? _colorType;

    protected override EncoderSettings BuildSettings() =>
        new JpegEncoderSettings(_quality, _colorType);
}
