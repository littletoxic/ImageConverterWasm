@using ImageConverter.Models.Encoding
@using ImageConverter.Models.Formats
@using SixLabors.ImageSharp.Formats
@attribute [FormatEncoder(KnownFormatIds.Gif)]
@inherits EncoderOptionsBase

<MudSelect T="FrameColorTableMode?" @bind-Value="_colorTableMode" @bind-Value:after="NotifySettingsChanged"
           Label="颜色表模式" Variant="Variant.Outlined" Class="mb-4">
    <MudSelectItem T="FrameColorTableMode?" Value="@((FrameColorTableMode?)null)">自动</MudSelectItem>
    <MudSelectItem T="FrameColorTableMode?" Value="FrameColorTableMode.Global">全局</MudSelectItem>
    <MudSelectItem T="FrameColorTableMode?" Value="FrameColorTableMode.Local">逐帧</MudSelectItem>
</MudSelect>

@code {
    private FrameColorTableMode? _colorTableMode;

    protected override EncoderSettings BuildSettings() =>
        new GifEncoderSettings(_colorTableMode, SkipMetadata);
}
