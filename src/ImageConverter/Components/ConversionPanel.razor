<MudPaper Class="@($"pa-4 {Class}")" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">转换设置</MudText>

    <MudSelect T="ImageFormatDescriptor"
               Label="目标格式"
               @bind-Value="TargetFormat"
               @bind-Value:after="() => TargetFormatChanged.InvokeAsync(TargetFormat)"
               Variant="Variant.Outlined"
               Class="mb-4">
        @foreach (var format in Formats)
        {
            <MudSelectItem Value="@format">@format.Name</MudSelectItem>
        }
    </MudSelect>

    <MudSwitch T="bool" Value="SkipMetadata"
               ValueChanged="OnSkipMetadataChanged"
               Color="MudBlazor.Color.Primary" Class="mb-4"
               Label="剥离元数据（EXIF、XMP 等）" />

    @switch (TargetFormat.Id.Value)
    {
        case KnownFormatIds.Bmp:
            <BmpEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
        case KnownFormatIds.Gif:
            <GifEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
        case KnownFormatIds.Jpeg:
            <JpegEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
        case KnownFormatIds.Png:
            <PngEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
        case KnownFormatIds.Tiff:
            <TiffEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
        case KnownFormatIds.Webp:
            <WebpEncoderOptions EncoderSettingsChanged="EncoderSettingsChanged" />
            break;
    }
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<ImageFormatDescriptor> Formats { get; set; } = [];
    [Parameter] public ImageFormatDescriptor TargetFormat { get; set; } = default!;
    [Parameter] public EventCallback<ImageFormatDescriptor> TargetFormatChanged { get; set; }
    [Parameter] public bool SkipMetadata { get; set; }
    [Parameter] public EventCallback<bool> SkipMetadataChanged { get; set; }
    [Parameter] public EventCallback<EncoderSettings> EncoderSettingsChanged { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task OnSkipMetadataChanged(bool value) =>
        SkipMetadataChanged.InvokeAsync(value);
}
