<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <!--
      WASM AOT currently crashes in the browser on .NET 11 preview with
      "MONO_WASM: function signature mismatch" / load_aot_module failures.
      Keep this proof-of-concept on the interpreter until the runtime stack
      is stable enough to revisit AOT, likely with CoreCLR-on-WASM progress.
    -->
    <!-- <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-preview.7.26381.103" PrivateAssets="all" />
    <!-- Keep the implementation aligned with the .NET 11 preview assemblies pulled in by Blazor. Remove after MudBlazor targets .NET 11. -->
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.0" />
  </ItemGroup>

</Project>
