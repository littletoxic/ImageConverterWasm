@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFormatCatalog FormatCatalog
@inject IConversionSession Session
@inject IImagePackageBuilder PackageBuilder

<PageTitle>图像格式转换</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">图像格式转换器</MudText>
<MudText Typo="Typo.body1" Class="mb-4" Color="MudBlazor.Color.Secondary">
    上传图像文件，选择目标格式，一键批量转换并下载。所有处理均在浏览器内完成。
</MudText>

@* === Upload Zone === *@
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">上传图像</MudText>

    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                   AppendMultipleFiles
                   Accept="@FormatCatalog.AcceptExtensions"
                   OnFilesChanged="OnFilesChanged"
                   MaximumFileCount="100"
                   Hidden="true"
                   DragAndDrop="true"
                   InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10 image-upload-input"
                   OnDrop="ClearDragClass"
                   OnDragEnter="SetDragClass"
                   OnDragLeave="ClearDragClass"
                   OnDragEnd="ClearDragClass">
        <CustomContent Context="fileUpload">
            <MudPaper Outlined="true"
                      Class="@GetDragClass()"
                      Style="min-height: 160px; cursor: pointer;"
                      @onclick="fileUpload.OpenFilePickerAsync">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload"
                         Size="MudBlazor.Size.Large" Color="MudBlazor.Color.Primary" />
                <MudText Typo="Typo.body1">点击或拖拽图像文件到此处（支持多选）</MudText>
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">
                    支持 @string.Join(", ", FormatCatalog.EncodableFormats.Select(f => f.Name))
                </MudText>
            </MudPaper>
        </CustomContent>
    </MudFileUpload>
</MudPaper>

@* === Conversion Settings + Batch Actions + Image Grid === *@
@if (Snapshot.Items.Count > 0)
{
    <ConversionPanel @bind-TargetFormat="_targetFormat"
                     Formats="FormatCatalog.EncodableFormats"
                     @bind-TargetFormat:after="OnTargetFormatChanged"
                     EncoderSettingsChanged="OnEncoderSettingsChanged"
                     Class="mb-4" />

    @* Batch Action Toolbar *@
    <MudPaper Class="pa-3 mb-4" Elevation="1">
        <div class="d-flex flex-column flex-sm-row align-sm-center gap-2">
            @if (_batchConverting)
            {
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Disabled="true">
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                    批量转换中 (@Snapshot.Batch.ConvertedCount/@Snapshot.Batch.TotalCount)...
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary"
                           StartIcon="@Icons.Material.Filled.Transform"
                           OnClick="ConvertAll"
                           Disabled="!HasLoadedItems">
                    全部转换
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DownloadAll"
                       Disabled="@(!HasDownloadableItems || Snapshot.Batch.IsConverting)">
                全部下载 (ZIP)
            </MudButton>
            <MudButton Variant="Variant.Text" Color="MudBlazor.Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       OnClick="ClearAll"
                       Disabled="Snapshot.Batch.IsConverting">
                清空全部
            </MudButton>
            <MudSpacer />
            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary" Class="align-self-center">
                共 @Snapshot.Items.Count 张图像
                @{
                    var doneCount = Snapshot.Items.Count(i => i.Status == ImageItemStatus.Done);
                }
                @if (doneCount > 0)
                {
                    <span>，@doneCount 张已转换</span>
                }
            </MudText>
        </div>
    </MudPaper>

    @* Image Grid *@
    <MudGrid Spacing="3">
        @foreach (var item in Snapshot.Items)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <ImageCard @key="item.Id"
                           Item="item"
                           Busy="Snapshot.Batch.IsConverting"
                           OnConvert="ConvertSingle"
                           OnDownload="DownloadSingle"
                           OnRemove="RemoveItem"
                           OnPreview="CreatePreview" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private const string DefaultDragClass =
        "relative rounded-lg border-2 border-dashed pa-4 d-flex flex-column align-center justify-center gap-2";
    private bool _dragging;
    private ImageFormatDescriptor _targetFormat = default!;
    private IJSObjectReference? _jsModule;

    private ConversionSessionSnapshot Snapshot => Session.Snapshot;
    private bool _batchConverting => Snapshot.Batch.IsConverting;

    private bool HasLoadedItems =>
        Snapshot.Items.Any(i => i.CanConvert);

    private bool HasDownloadableItems =>
        Snapshot.Items.Any(i => i.CanDownload);

    private string GetDragClass() =>
        _dragging ? $"{DefaultDragClass} mud-border-primary" : DefaultDragClass;

    private void SetDragClass() => _dragging = true;
    private void ClearDragClass() => _dragging = false;

    protected override void OnInitialized()
    {
        _targetFormat = FormatCatalog.DefaultTargetFormat;
        Session.SetTargetFormat(_targetFormat.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Pages/Home.razor.js");
        }
    }

    private void OnFilesChanged(InputFileChangeEventArgs e)
    {
        ClearDragClass();
        var newFiles = e.GetMultipleFiles(maximumFileCount: 100)
            .Select(file => new BrowserImageFile(
                file.Name,
                file.Size,
                maxFileSize => file.OpenReadStream(maxFileSize)))
            .ToList();

        var result = Session.AddFiles(newFiles);
        if (result is AddFilesSucceeded succeeded)
            foreach (var itemId in succeeded.ItemIds)
                _ = LoadItemAsync(itemId);
    }

    private async Task LoadItemAsync(Guid itemId)
    {
        await Session.LoadImageAsync(itemId);
        StateHasChanged();
    }

    private void OnTargetFormatChanged()
    {
        Session.SetTargetFormat(_targetFormat.Id);
    }

    private void OnEncoderSettingsChanged(EncoderSettings settings) =>
        Session.UpdateEncoderSettings(settings);

    private async Task ConvertSingle(Guid itemId)
    {
        var convertTask = Session.ConvertImageAsync(itemId);
        StateHasChanged();
        await convertTask;
        StateHasChanged();
    }

    private async Task ConvertAll()
    {
        await Session.ConvertAllAsync(StateHasChanged);
    }

    private async Task DownloadSingle(Guid itemId)
    {
        if (_jsModule is null) return;
        if (Session.OpenConvertedImage(itemId) is not OpenConvertedImageSucceeded download)
            return;

        using var streamRef = new DotNetStreamReference(download.Stream, leaveOpen: true);
        await _jsModule.InvokeVoidAsync("downloadFileFromStream",
            download.OutputFileName, streamRef);
    }

    private async Task DownloadAll()
    {
        if (_jsModule is null) return;
        var entries = Snapshot.Items
            .Where(i => i.CanDownload)
            .Select(i => Session.OpenConvertedImage(i.Id))
            .Select(result => result.Value)
            .OfType<OpenConvertedImageSucceeded>()
            .Select(download => new ImagePackageEntrySource(download.OutputFileName, download.Stream))
            .ToList();

        if (await PackageBuilder.BuildAsync(entries, "converted-images.zip") is not BuildImagePackageSucceeded built)
            return;

        using var streamRef = new DotNetStreamReference(built.Package.Stream);
        await _jsModule.InvokeVoidAsync("downloadFileFromStream", built.Package.FileName, streamRef);
    }

    private async Task<string?> CreatePreview(Guid itemId)
    {
        await Task.Yield();
        return Session.CreatePreview(itemId, 1024) switch
        {
            CreatePreviewSucceeded preview => preview.DataUrl,
            _ => null
        };
    }

    private void RemoveItem(Guid itemId) =>
        Session.RemoveItem(itemId);

    private void ClearAll()
    {
        Session.Clear();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Session.Clear();

        if (_jsModule is not null)
            await _jsModule.DisposeAsync();
    }
}
